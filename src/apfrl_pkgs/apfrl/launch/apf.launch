<launch>
    <node exec="rviz2" name="rviz2" pkg="rviz2" args="-d $(find-pkg-share apfrl)/rviz/apfrl.rviz" output="screen"/>
    <node pkg="obs_generator_rplidar" exec="obs_generator_rplidar_node" name="obs_generator_rplidar" output="screen"/>


    <node pkg="apf" exec="apf_node" name="apf" output="screen">
        <param name="model_path" value="$(find-pkg-share apfrl)/models/apfrl_model.pt" />
        <param name="use_apfrl" value="false" />
        <param name="xMax" value="1.0" />	
        <remap from="cmd_vel" to="cmd_vel" />
    </node>
    
</launch>
